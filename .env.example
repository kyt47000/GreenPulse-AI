# ─── Environment Variables ───────────────────────────────────────────────────
# Backend secrets — NEVER commit .env to git
# Copy this file to backend/.env and fill in your credentials

# ─── Data Source ──────────────────────────────────────────────────────────────
# Controls where the backend reads sensor/telemetry data from.
#
#   simulator   — SCADA simulator (default). Works offline with no credentials.
#                 A background tick runs every 3 s, applying realistic Math.random()
#                 sensor drift, edge-case injection, and SSE push to the frontend.
#
#   ibm-live    — IBM Cloud real-time data. Requires Event Streams + PostgreSQL
#                 credentials below. See backend/src/data/live/ibmLiveSource.ts.
#
DATA_SOURCE=simulator

# ─── IBM AI (watsonx / Granite) ──────────────────────────────────────────────
# Optional. If not set, the backend runs in mock AI mode.
# Get these from cloud.ibm.com → watsonx.ai → your project → Manage → API Keys
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_URL=https://us-south.ml.cloud.ibm.com

# ─── IBM Cloud Event Streams (Kafka) ─────────────────────────────────────────
# Required when DATA_SOURCE=ibm-live
# Get from IBM Cloud → Event Streams instance → Service credentials
EVENT_STREAMS_BROKER=
EVENT_STREAMS_API_KEY=

# ─── IBM Cloud Databases (PostgreSQL) ────────────────────────────────────────
# Required when DATA_SOURCE=ibm-live (time-series telemetry history)
# Get from IBM Cloud → Databases for PostgreSQL → Connection → JDBC URL
DATABASE_URL=

# ─── Server Config ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
