# ─── Environment Variables ───────────────────────────────────────────────────
# Backend secrets — NEVER commit .env to git
# Copy this file to .env and fill in your credentials

# ─── IBM AI (watsonx / Granite) ──────────────────────────────────────────────
IBM_API_KEY=
IBM_PROJECT_ID=
IBM_URL=https://us-south.ml.cloud.ibm.com

# ─── Server Config ────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Notes ────────────────────────────────────────────────────────────────────
# Without IBM_API_KEY and IBM_PROJECT_ID, the backend will run in mock mode
# All AI responses will be generated by the GreenPulse mock engine
# The frontend remains fully functional in mock mode
